# Names only. Do not put real values in git.
# Copy to artifacts/api-server/.env for local `pnpm --filter @workspace/api-server run dev`.
# The dev server reads this file. It is gitignored.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
LOG_LEVEL=info

# Optional. Development defaults to 8787, which the Vite dev server proxies to.
# Production refuses to listen when PORT is missing.
PORT=8787

# Used by Drizzle in lib/db only. The API server does not open this connection.
# Do not point this at production.
DATABASE_URL=

# Credentialed browser origins. Comma-separated exact origins. Not a secret.
# Unset in development allows only http://localhost:5173, http://127.0.0.1:5173,
# http://localhost:5174, and http://127.0.0.1:5174.
# Production must set this before deploy:
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Must stay unset or false in production. Unset allows https://*.vercel.app
# only when VERCEL_ENV=preview.
# CORS_ALLOW_VERCEL_PREVIEWS=false
