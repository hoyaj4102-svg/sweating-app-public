# Names only. Copy to artifacts/swetin-workout-dating/.env for local Vite.
# Defaults: PORT=5173, BASE_PATH=/, API proxy http://127.0.0.1:8787.

PORT=5173
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:8787

# Development-only. Production builds ignore these because import.meta.env.DEV is false.
VITE_CLASS_DEMO_MODE=false
VITE_ENABLE_DEMO_MODE=false

# Optional browser DSN, injected at build time. Empty disables Sentry. Never commit a real value.
# VITE_SENTRY_DSN=
